            Array : vec ICRC3Value;
          };
        };
        archived_blocks : Vec;
      },
    ) query;
};
service : (Args_20) -> {
  __get_premint_entry_test : (Args) -> (Result) query;
  __get_private_entry_test : (Args_1) -> (Result) query;
  __get_public_entry_test : (Args_2) -> (Result_1) query;
  append_file : (Args_3) -> (Result_2);
  burn_nft : (nat) -> (Result_3);
  cancel_private_content_upload : (Args_4) -> (Result_4);
  cancel_upload : (Args_5) -> (Result_5);
  derive_vetkey : (Args_6) -> (Result_6);
  derive_vetkey_by_entry : (Args_7) -> (Result_6);
  derive_vetkey_public_key : (null) -> (Result_7);
  finalize_private_content_upload : (Args_8) -> (Result_8);
  finalize_upload : (Args_5) -> (Result_9);
  get_all_storage_subcanisters : () -> (vec principal) query;
  get_all_uploads : (opt nat, opt nat) -> (Result_10) query;
  get_upload_status : (text) -> (Result_11) query;
  get_user_permissions : (Args_9) -> (Result_12) query;
  grant_permission : (Args_10) -> (Result_13);
  has_permission : (Args_11) -> (Result_14) query;
  icrc10_supported_standards : () -> (vec SupportedStandard) query;
  icrc21_canister_call_consent_message : (ConsentMessageRequest) -> (
      Result_15,
    ) query;
  icrc37_approve_collection : (vec ApproveCollectionArg) -> (Result_16);
  icrc37_approve_tokens : (vec ApproveTokenArg) -> (Result_17);
  icrc37_get_collection_approvals : (
      Account,
      opt ApproveCollectionArg,
      opt nat,
    ) -> (vec ApproveCollectionArg) query;
  icrc37_get_token_approvals : (nat, opt ApproveTokenArg, opt nat) -> (
      vec ApproveTokenArg,
    ) query;
  icrc37_is_approved : (vec IsApprovedArg) -> (vec bool) query;
  icrc37_max_approvals_per_token_or_collection : () -> (opt nat) query;
  icrc37_max_revoke_approvals : () -> (opt nat) query;
  icrc37_revoke_collection_approvals : (vec RevokeCollectionApprovalArg) -> (
      Result_18,
    );
  icrc37_revoke_token_approvals : (vec RevokeTokenApprovalArg) -> (Result_19);
  icrc37_transfer_from : (vec TransferFromArg) -> (Result_20);
  icrc3_get_archives : (null) -> (vec ICRC3ArchiveInfo) query;
  icrc3_get_blocks : (vec GetBlocksRequest) -> (GetBlocksResult_1) query;
  icrc3_get_properties : (null) -> (ICRC3Properties) query;
  icrc3_get_tip_certificate : (null) -> (ICRC3DataCertificate) query;
  icrc3_supported_block_types : (null) -> (vec SupportedBlockType) query;
  icrc7_atomic_batch_transfers : () -> (opt bool) query;
  icrc7_balance_of : (vec Account) -> (vec nat) query;
  icrc7_collection_metadata : () -> (vec record { text; ICRC3Value_1 }) query;
  icrc7_default_take_value : () -> (opt nat) query;
  icrc7_description : () -> (opt text) query;
  icrc7_logo : () -> (opt text) query;
  icrc7_max_memo_size : () -> (opt nat) query;
